<Project>
  <!-- Custom build targets shared by all projects -->
  <!-- Shared package metadata is evaluated here because project properties are available after project evaluation. -->
  <PropertyGroup Condition="'$(IsPackable)'=='true'">
    <Authors Condition="'$(Authors)'==''">KeelMatrix</Authors>
    <RepositoryUrl Condition="'$(RepositoryUrl)'==''">https://github.com/KeelMatrix/Redaction</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)'==''">git</RepositoryType>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)'==''">MIT</PackageLicenseExpression>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)'==''">https://github.com/KeelMatrix/Redaction#readme</PackageProjectUrl>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)'=='' and Exists('$(MSBuildProjectDirectory)\README.md')">README.md</PackageReadmeFile>
    <PackageIcon Condition="'$(PackageIcon)'=='' and Exists('$(MSBuildThisFileDirectory)icon.png')">icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)'=='true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack the project README and repo icon into the NuGet package root when present. -->
  <ItemGroup Condition="'$(IsPackable)'=='true'">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="" Link="README.md" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Link="icon.png" Condition="Exists('$(MSBuildThisFileDirectory)icon.png') and '$(PackageIcon)'!=''" />
  </ItemGroup>
  
  <PropertyGroup Condition="'$(IsTestProject)'=='true'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

<!--
  Public API maintenance
  ######################
  - After adding or changing public members, update the *PublicAPI.Shipped.txt*
    and *PublicAPI.Unshipped.txt* files in the affected project.
  - Keep only a single shipped/unshipped pair per project. If an API is TFM-specific,
    append a comment to the API line:  // TFM: net8.0  or  // TFM: netstandard2.0
-->

</Project>
